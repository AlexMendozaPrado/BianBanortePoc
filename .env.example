# Configuración de la aplicación BIAN POC
# Copia este archivo a .env.local y configura las variables según tu entorno

# Información general de la aplicación
NEXT_PUBLIC_APP_NAME="BIAN POC - Banorte"
NEXT_PUBLIC_APP_VERSION="1.0.0"
NEXT_PUBLIC_BIAN_VERSION="12.0.0"

# URLs de la aplicación
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# Configuración de OpenAI (opcional)
OPENAI_API_KEY="tu-api-key-aqui"
OPENAI_MODEL="gpt-4"
OPENAI_MAX_TOKENS=1000

# Configuración de base de datos (futuro)
# DATABASE_URL="postgresql://usuario:password@localhost:5432/bian_poc"
# DATABASE_POOL_SIZE=10

# Configuración de autenticación (futuro)
# NEXTAUTH_URL="http://localhost:3000"
# NEXTAUTH_SECRET="tu-secret-aqui"

# Configuración de logging
LOG_LEVEL="info"
NODE_ENV="development"

# Configuración de exportación
EXPORT_MAX_RECORDS=10000
EXPORT_TIMEOUT_MS=30000

# Configuración de búsqueda
SEARCH_MAX_RESULTS=100
SEARCH_TIMEOUT_MS=5000

# Configuración de cache (futuro)
# REDIS_URL="redis://localhost:6379"
# CACHE_TTL=3600

# Configuración de monitoreo (futuro)
# SENTRY_DSN="tu-sentry-dsn-aqui"
# ANALYTICS_ID="tu-analytics-id-aqui"

# Configuración de email (futuro)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="tu-email@banorte.com"
# SMTP_PASS="tu-password-aqui"

# Configuración de almacenamiento (futuro)
# AWS_ACCESS_KEY_ID="tu-access-key-aqui"
# AWS_SECRET_ACCESS_KEY="tu-secret-key-aqui"
# AWS_REGION="us-east-1"
# AWS_S3_BUCKET="bian-poc-storage"

# Configuración de desarrollo
NEXT_TELEMETRY_DISABLED=1
DISABLE_ESLINT_PLUGIN=false
ANALYZE_BUNDLE=false
